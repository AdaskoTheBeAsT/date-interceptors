{
  "name": "axios-interceptor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/axios-interceptor/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tools/testing/jest-reporters.cjs",
        "{workspaceRoot}/tools/testing/swc-transform.cjs",
        "{workspaceRoot}/tools/testing/jsdom-environment.cjs",
        "{workspaceRoot}/tools/testing/coverage-thresholds.json",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "@swc/jest",
            "jest-stare",
            "jest-html-reporters",
            "jest-xunit",
            "jest-sonar",
            "jest-trx-results-processor",
            "jest-junit"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/.reports/{projectRoot}",
        "{workspaceRoot}\\.reports\\libs\\axios-interceptor\\coverage"
      ]
    }
  }
}
