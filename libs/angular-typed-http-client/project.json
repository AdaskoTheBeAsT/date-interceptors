{
  "name": "angular-typed-http-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/angular-typed-http-client/src",
  "prefix": "adaskothebeast",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/angular-typed-http-client/ng-package.json",
        "tsConfig": "libs/angular-typed-http-client/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/angular-typed-http-client/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tools/testing/jest-reporters.cjs",
        "{workspaceRoot}/tools/testing/swc-transform.cjs",
        "{workspaceRoot}/tools/testing/jsdom-environment.cjs",
        "{workspaceRoot}/tools/testing/coverage-thresholds.json",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "jest-preset-angular",
            "jest-stare",
            "jest-html-reporters",
            "jest-xunit",
            "jest-sonar",
            "jest-trx-results-processor",
            "jest-junit"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/.reports/{projectRoot}",
        "{workspaceRoot}\\.reports\\libs\\angular-typed-http-client\\coverage"
      ]
    }
  }
}
