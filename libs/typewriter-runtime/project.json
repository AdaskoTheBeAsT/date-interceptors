{
  "name": "typewriter-runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/typewriter-runtime/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["typewriter-schema"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tools/testing/jest-reporters.cjs",
        "{workspaceRoot}/tools/testing/swc-transform.cjs",
        "{workspaceRoot}/tools/testing/jsdom-environment.cjs",
        "{workspaceRoot}/tools/testing/coverage-thresholds.json",
        {
          "externalDependencies": [
            "jest",
            "@nx/jest",
            "ts-jest",
            "@swc/jest",
            "jest-junit",
            "jest-sonar"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/.reports/{projectRoot}",
        "{workspaceRoot}\\.reports\\libs\\typewriter-runtime\\coverage"
      ]
    }
  }
}
