{
  "name": "react-redux-toolkit-hierarchical-date-hook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/react-redux-toolkit-hierarchical-date-hook/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.cjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "args": ["**/*.{ts,tsx,js,jsx}", "package.json"]
      }
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["extends", "files", "include"]
        },
        {
          "externalDependencies": ["rollup"]
        }
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/react-redux-toolkit-hierarchical-date-hook/jest.config.ts"
      }
    }
  }
}
