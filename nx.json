{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.cjs",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{workspaceRoot}/.reports/{projectRoot}/eslint.json"],
      "configurations": {
        "ci": {
          "args": [
            "--format=json",
            "--output-file=../../.reports/{projectRoot}/eslint.json"
          ]
        }
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "@nx/vite:build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/rollup:rollup": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.cts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/FixJSDOMEnvironment.ts",
      "!{projectRoot}/eslint.config.cjs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tools/rollup/**/*"
    ]
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "generators": {
    "@nx/angular:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "css",
      "type": "component"
    },
    "@nx/react": {
      "application": {
        "babel": true
      },
      "library": {
        "unitTestRunner": "jest"
      }
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@nx/angular:scam": {
      "type": "component"
    },
    "@nx/angular:scam-directive": {
      "type": "directive"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "release": {
    "projects": [
      "angular-date-http-interceptor",
      "angular-typed-http-client",
      "axios-interceptor",
      "hierarchical-convert-core",
      "hierarchical-convert-to-date",
      "hierarchical-convert-to-date-fns",
      "hierarchical-convert-to-dayjs",
      "hierarchical-convert-to-decimal",
      "hierarchical-convert-to-js-joda",
      "hierarchical-convert-to-luxon",
      "hierarchical-convert-to-moment",
      "hierarchical-convert-to-temporal",
      "hierarchical-convert-to-uuid",
      "react-redux-toolkit-hierarchical-date-hook",
      "typewriter-http-angular",
      "typewriter-http-axios",
      "typewriter-http-fetch",
      "typewriter-runtime",
      "typewriter-schema"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "preVersionCommand": "yarn nx run-many -t build",
      "currentVersionResolver": "disk",
      "preserveMatchingDependencyRanges": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false
    }
  },
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/rollup/plugin",
      "options": {
        "buildTargetName": "build"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "libs/angular-date-http-interceptor/**/*",
        "libs/angular-typed-http-client/**/*",
        "libs/axios-interceptor/**/*",
        "libs/hierarchical-convert-core/**/*",
        "libs/hierarchical-convert-to-date/**/*",
        "libs/hierarchical-convert-to-date-fns/**/*",
        "libs/hierarchical-convert-to-dayjs/**/*",
        "libs/hierarchical-convert-to-decimal/**/*",
        "libs/hierarchical-convert-to-js-joda/**/*",
        "libs/hierarchical-convert-to-luxon/**/*",
        "libs/hierarchical-convert-to-moment/**/*",
        "libs/hierarchical-convert-to-temporal/**/*",
        "libs/hierarchical-convert-to-uuid/**/*",
        "libs/react-redux-toolkit-hierarchical-date-hook/**/*",
        "libs/typewriter-http-angular/**/*",
        "libs/typewriter-http-axios/**/*",
        "libs/typewriter-http-fetch/**/*",
        "libs/typewriter-runtime/**/*",
        "libs/typewriter-schema/**/*"
      ]
    }
  ]
}
